{
  "name": "quicktex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "sh wasm-core/build.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "bun test --timeout 120000 tests",
    "test:collab": "bun run build && bun test --timeout 120000 tests/collaboration.test.ts tests/collaboration-model.test.ts tests/manual-peer.test.ts tests/browser/collaboration.test.ts tests/browser/collaboration-lifecycle.test.ts",
    "test:rust": "sh wasm-core/test.sh",
    "bench": "bun bench/run.ts",
    "test:parity": "bun bench/parity.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "binaryen": "^132.0.0",
    "heroicons": "^2.2.0",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "fflate": "^0.8.3",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  }
}
